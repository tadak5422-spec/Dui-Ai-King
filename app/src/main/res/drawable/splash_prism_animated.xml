<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the Dui Studio Ai "D" mark, fading and scaling into place.
     Kept as an animated-vector so the splash still animates with the new branding. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <group
                android:name="mark"
                android:pivotX="54"
                android:pivotY="54">
                <path android:pathData="M54,18a36,36 0,1 0,0 72a36,36 0,1 0,0 -72Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="radial"
                            android:centerX="54"
                            android:centerY="54"
                            android:gradientRadius="36"
                            android:startColor="#404B9DDB"
                            android:endColor="#004B9DDB" />
                    </aapt:attr>
                </path>
                <path
                    android:fillType="evenOdd"
                    android:pathData="M32,24 H58 A30,30 0 0 1 58,84 H32 Z M44,36 H58 A18,18 0 0 1 58,72 H44 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="32"
                            android:startY="24"
                            android:endX="78"
                            android:endY="84"
                            android:startColor="#FFF8FAFF"
                            android:endColor="#FF9AA0AB" />
                    </aapt:attr>
                </path>
                <path android:fillColor="#80FFB74D" android:pathData="M34,30 H37 V78 H34 Z" />
                <path android:fillColor="#FFFFB74D" android:pathData="M68,48 L74,54 L68,60 L62,54 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="450"
                    android:valueFrom="0.88"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="450"
                    android:valueFrom="0.88"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:duration="350"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
