<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: no startup window at all. No preview window, no splash icon,
         no wordmark and a transparent background, so the launcher stays visible until the chat
         draws its first frame (Android 12+ still creates its system splash window, but it is
         transparent). -->
    <style name="Theme.Dui" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_bars</item>
    </style>

    <!-- Facebook Messenger-style Floating Multitasking Window Theme -->
    <style name="Theme.DuiAI.FloatingTranslucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>