<?xml version="1.0" encoding="utf-8"?><!--
   Backup is off (android:allowBackup="false", android:fullBackupContent="false"). This file is kept as a
   second line of defence for pre-Android-12 devices: chats, provider tokens, SSH keys and the Linux
   userland live in private storage and must not be copied into a cloud backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
